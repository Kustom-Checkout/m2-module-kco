declare(strict_types=1);

use Klarna\Kco\Block\Adminhtml\Order\CustomerToken;
use Magento\Framework\Escaper;

/** @var CustomerToken $block */
/** @var Escaper $escaper */
$maskedToken = $block->getMaskedToken();
?>
<?php if ($maskedToken !== null): ?>
<table class="data-table admin__table-secondary">
    <tr>
        <th><?= $escaper->escapeHtml(__('Recurring token')) ?>:</th>
        <td><?= $escaper->escapeHtml($maskedToken) ?></td>
    </tr>
</table>
<?php endif; ?>
